;---------------------------------------
; CMD standard (Statedef -1)
;---------------------------------------

[Statedef -1]
;---------------------------------------
; Presa Calpestante
[State -1]
type = ChangeState
value = 3000
triggerall = var(59) != 1
triggerall = power >= 2000
triggerall = command = "PresaCalpestante"
triggerall = statetype = S
triggerall = ctrl
triggerall = stateno != 100
trigger1 = p2bodydist X <= 30
trigger1 = (p2statetype = S) || (p2statetype = C)
trigger1 = p2movetype != H

;---------------------------------------
; Sacro Toro Terremotante
[State -1]
type = Varset
triggerall = var(59) != 1
trigger1 = command = "GreatHornLv1-1"
v = 22
value = 1

[State -1]
type = Varset
triggerall = var(59) != 1
trigger1 = command = "GreatHornLv1-2"
v = 22
value = 2

[State -1]
type = Varset
triggerall = var(59) != 1
trigger1 = command = "GreatHornLv1-3"
v = 22
value = 3

[State -1]
type = ChangeState
value = 3100
triggerall = var(59) != 1
triggerall = statetype != A
triggerall = power >= 1000
triggerall = ctrl
trigger1 = command = "GreatHornLv1-1"
trigger2 = command = "GreatHornLv1-2"
trigger3 = command = "GreatHornLv1-3"

