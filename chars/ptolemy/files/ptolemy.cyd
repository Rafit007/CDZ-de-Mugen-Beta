;---------------------------------------------------------------------------
; PTOLEMY COMMAND FILE by FobiaZ & Tony ADV
;---------------------------------------------------------------------------

[Defaults]
command.time = 15
command.buffer.time = 1

;---------------------------------------
; AI Commands
;---------------------------------------

[Command]
name = "AI1"
command = a, a, a
time = 1

[Command]
name = "AI2"
command = b, b, b
time = 1

[Command]
