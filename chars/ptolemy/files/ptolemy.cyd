;---------------------------------------
; Super Moves
;---------------------------------------

; Phantom Arrow (*)
[Command]
name = "phantomarrow1"
command = B, DB, D, DF, F, x
time = 35

; Phantom Arrow (illusory)(*)
[Command]
name = "phantomarrow2"
command = B, DB, D, DF, F, y
time = 35

; Phantom Arrow (maximum power)(*)
[Command]
name = "phantomarrow3"
command = B, DB, D, DF, F, z
time = 35

;(*) Aerial too

;---------------------------------------
; Fatality Moves (P2 Life < 250)
;---------------------------------------

; Phantom Arrow (with golden arrow) (*)
[Command]
name = "phantomarrow4"
command = B, DB, D, DF, F, a
time = 35
[Command]
name = "phantomarrow4"
command = B, DB, D, DF, F, b
time = 35
[Command]
name = "phantomarrow4"
command = B, DB, D, DF, F, c
time = 35

;(*) Aerial too

;---------------------------------------
; Special Moves
;---------------------------------------

; Arrows (*)
[Command]
name = "hailofarrows1"
command = ~D, DF, F, x
time = 25
[Command]
name = "hailofarrows2"
command = ~D, DF, F, y
time = 25
[Command]
name = "hailofarrows3"
command = ~D, DF, F, z
time = 25

; Combo (*)
[Command]
name = "combo1"
command = ~D, DB, B, x
time = 25
[Command]
name = "combo2"
command = ~D, DB, B, y
time = 25
[Command]
name = "combo3"
command = ~D, DB, B, z
time = 25

; Shadow Kick (*)
[Command]
name = "shadowkick"
command = ~D, DB, B, a
time = 25
[Command]
name = "shadowkick"
command = ~D, DB, B, b
time = 25
[Command]
name = "shadowkick"
command = ~D, DB, B, c
time = 25

;---------------------------------------
; 2/3 Button Combination
;---------------------------------------

; Air Recover
[Command]
name = "recovery";Required (do not remove)
command = x+y
time = 1

; Teleport
[Command]
name = "teleport"
command = b+c
time = 5

; Cosmo Charge
[Command]
name = "charge1"
command = /c
time= 1
[Command]
name = "charge2"
command = /z
time= 1

;---------------------------------------
; Dir + Button
;---------------------------------------

[Command]
name = "down_a"
command = /$D,a
time = 1

[Command]
name = "down_b"
command = /$D,b
time = 1

;---------------------------------------
; Single Button
;---------------------------------------

[Command]
name = "a"
command = a
time = 1

[Command]
name = "b"
command = b
time = 1

[Command]
name = "c"
command = c
time = 1

[Command]
name = "x"
command = x
time = 1

[Command]
name = "y"
command = y
time = 1

[Command]
name = "z"
command = z
time = 1

[Command]
name = "start"
command = s
time = 1

;---------------------------------------
; Hold Dir
;---------------------------------------

[Command]
name = "holdfwd";Required (do not remove)
command = /$F
time = 1

[Command]
name = "holdback";Required (do not remove)
command = /$B
time = 1

[Command]
name = "holdup" ;Required (do not remove)
command = /$U
time = 1

[Command]
name = "holddown";Required (do not remove)
command = /$D
time = 1

;---------------------------------------
; Double Tap
;---------------------------------------

; Run Forward
[Command]
name = "FF"     ;Required (do not remove)
command = F, F
time = 10

; Run Back
[Command]
name = "BB"     ;Required (do not remove)
command = B, B
time = 10

; Moves List
[Command]
name = "ss"
command = s, s
time = 10

;---------------------------------------
; CMD standard (Statedef -1)
;---------------------------------------

[Statedef -1]

;------------------------------------------------------
; Phantom Arrow (maximum power) (in air)
[State -1]
type = ChangeState
value = 3700
triggerall = Var(59) = 0
triggerall = command = "phantomarrow3"
triggerall = power >= 3000
triggerall = !var(7)
trigger1 = statetype = A
trigger1 = ctrl = 1
