;---------------------------------------
; Super Moves
;---------------------------------------

; Fulmine di Pegasus 1 / Pegasus RyuSeiKen 1 (*)
[Command]
name = "RyuSeiKen1"
command = B, DB, D, DF, F, x
time = 35

; Fulmine di Pegasus 2 / Pegasus RyuSeiKen 2 (*)
[Command]
name = "RyuSeiKen2"
command = B, DB, D, DF, F, y
time = 35

; Cometa di Pegasus / Pegasus SuiSeiKen (*)
[Command]
name = "SuiSeiKen"
command = B, DB, D, DF, F, z
time = 35

; Spirale di Pegasus / Pegasus Rolling Crash
[Command]
name = "RollingCrash"
command = B, DB, D, DF, F, a
time = 35

;---------------------------------------
; Fatality Moves (p2Life < 250)
;---------------------------------------

; Freccia di Sagitter / Sagittarius Arrow
[Command]
name = "SagittariusArrow"
command = B, DB, D, DF, F, b
time = 35

;---------------------------------------
; Desperate Moves (Life < 250)
;---------------------------------------

; Scudo di Atena / Athena Shield
[Command]
name = "AthenaShield"
command = B, DB, D, DF, F, c
time = 35

;---------------------------------------
; Special Moves
;---------------------------------------

; Meteore di Pegasus / Pegasus Meteors
[Command]
name = "PegasusMeteors1"
command = D, DF, F, x
time = 25
[Command]
name = "PegasusMeteors2"
command = D, DF, F, y
time = 25
[Command]
name = "PegasusMeteors3"
command = D, DF, F, z
time = 25

; Gomitata / Elbow Dash
[Command]
name = "ElbowDash"
command = D, DB, B, x
time = 25
[Command]
name = "ElbowDash"
command = D, DB, B, y
time = 25
[Command]
name = "ElbowDash"
command = D, DB, B, z
time = 25

; Uppercut volante / Flying Uppercut (*)
[Command]
name = "FlyingUppercut"
command = F, D, DF, x
time = 30
[Command]
name = "FlyingUppercut"
command = F, D, DF, y
time = 30
[Command]
name = "FlyingUppercut"
command = F, D, DF, z
time = 30

; Scivolata / Slide
[Command]
name = "Slide"
command = F, D, DF, a
time = 30
[Command]
name = "Slide"
command = F, D, DF, b
time = 30
[Command]
name = "Slide"
command = F, D, DF, c
time = 30

; Calcio di Pegasus / Pegasus Kick
[Command]
name = "PegasusKick1"
command = D, DF, F, a
time = 25
[Command]
name = "PegasusKick2"
command = D, DF, F, b
time = 25
[Command]
name = "PegasusKick3"
command = D, DF, F, c
time = 25

; Combo Aerea / Aerial Combo
[Command]
name = "AerialCombo"
command = D, DB, B, a
time = 30
[Command]
name = "AerialCombo"
command = D, DB, B, b
time = 30
[Command]
name = "AerialCombo"
command = D, DB, B, c
time = 30

; Calcio missile / Missile Kick
[Command]
name = "MissileKick"
command = D, DF, F, a
time = 25
[Command]
name = "MissileKick"
command = D, DF, F, b
time = 25
[Command]
name = "MissileKick"
command = D, DF, F, c
time = 25

; Calcio Volante di Pegasus / Pegasus Flying Kick
[Command]
name = "PegasusFlyingKick"
command = D, DB, B, a
time = 25
[Command]
name = "PegasusFlyingKick"
command = D, DB, B, b
time = 25
[Command]
name = "PegasusFlyingKick"
command = D, DB, B, c
time = 25

;(*) Aerial too

;---------------------------------------
; 2/3 Button Combination
;---------------------------------------

; Recupero aereo / Air Recover
[Command]
name = "recovery";Required (do not remove)
command = x+y
time = 1

; Settimo Senso / 7th Sense
[Command]
name = "7sense"
command = a+x
time = 5

; Carica Cosmo / Cosmo Charge
[Command]
name = "charge1"
command = /z
time= 1
[Command]
name = "charge2"
command= /c
time= 1

; Opposizione Cosmica / Super Guard
[Command]
name = "guard"
command = x+y
time = 1

;---------------------------------------
; Single Button
;---------------------------------------

[Command]
name = "a"
command = a
time = 1

[Command]
name = "b"
command = b
time = 1

[Command]
name = "c"
command = c
time = 1

[Command]
name = "x"
command = x
time = 1

[Command]
name = "y"
command = y
time = 1

[Command]
name = "z"
command = z
time = 1

[Command]
name = "start"
command = s
time = 1

;---------------------------------------
; Hold Button
;---------------------------------------

[Command]
name = "down_a"
command = /$D,a
time = 1

[Command]
name = "down_b"
command = /$D,b
time = 1

;---------------------------------------
; Hold Dir
;---------------------------------------

[Command]
name = "holdfwd";Required (do not remove)
command = /$F
time = 1

[Command]
name = "holdback";Required (do not remove)
command = /$B
time = 1

[Command]
name = "holdup" ;Required (do not remove)
command = /$U
time = 1

[Command]
name = "holddown";Required (do not remove)
command = /$D
time = 1

;---------------------------------------
; Double Tap
;---------------------------------------

; Corsa Avanti / Run Forward
[Command]
name = "FF"     ;Required (do not remove)
command = F, F
time = 10

; Scatto indietro / Run Back
[Command]
name = "BB"     ;Required (do not remove)
command = B, B
time = 10

; Lista Mosse / Moves List
[Command]
name = "ss"
command = s, s
time = 10

;---------------------------------------
; CMD standard (Statedef -1)
;---------------------------------------

[Statedef -1]

;---------------------------------------

; Cosmo Charge
[State -1]
type = ChangeState
value = 900
triggerall = Var(59) = 0
triggerall = var(8) = 0
triggerall = Power < 3000
triggerall = command = "charge1"
triggerall = command = "charge2"
trigger1 = statetype = S
trigger1 = ctrl = 1

; Super Guard
[State -1]
