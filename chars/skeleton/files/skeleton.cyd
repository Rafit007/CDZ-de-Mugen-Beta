time = 30

;1000 Kicks 1
[Command] 
name = "1000kicks" 
command = B, DB, D, DF, F, a
time = 30

;1000 Kicks 2
[Command] 
name = "1000kicks2" 
command = B, DB, D, DF, F, b
time = 30

;Super Combo Teleport
[Command] 
name = "superteleportation" 
command = B, DB, D, DF, F, c
time = 30

