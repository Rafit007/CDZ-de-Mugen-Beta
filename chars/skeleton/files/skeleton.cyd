command = /$U
time = 1

[Command]
name = "holddown";Required (do not remove)
command = /$D
time = 1

; Don't remove the following line. It's required by the CMD standard.
[Statedef -1]

;===========================================================================

;1000 pugni 1
[State -1]
type = changestate
value = 3000
triggerall = (command = "1000punches") && (power >= 1000)
trigger1 = ((statetype = S) && (ctrl = 1)) || ((stateno = [200,500]) && (movecontact = 1)) || ((stateno = [1000,2000]) && (movecontact = 1))
trigger1 = statetype != A

;1000 calci 2
[State -1]
type = changestate
value = 3200
triggerall = (command = "1000kicks") && (power >= 1000)
trigger1 = ((statetype = S) && (ctrl = 1)) || ((stateno = [200,500]) && (movecontact = 1)) || ((stateno = [1000,2000]) && (movecontact = 1))
trigger1 = statetype != A

;1000 pugni 2
[State -1]
type = changestate
value = 3100
triggerall = (command = "1000punches2") && (power >= 2000)
trigger1 = ((statetype = S) && (ctrl = 1)) || ((stateno = [200,500]) && (movecontact = 1)) || ((stateno = [1000,2000]) && (movecontact = 1))
trigger1 = statetype != A

;1000 calci 2
[State -1]
type = changestate
value = 3300
triggerall = (command = "1000kicks2") && (power >= 2000)
trigger1 = ((statetype = S) && (ctrl = 1)) || ((stateno = [200,500]) && (movecontact = 1)) || ((stateno = [1000,2000]) && (movecontact = 1))
trigger1 = statetype != A

;super harpoon
[State -1]
type = ChangeState
value = 3400
triggerall = command = "superfireball"
triggerall = power >= 3000
trigger1 = statetype != A
trigger1 = ctrl = 1

;super combo teleport
[State -1]
type = ChangeState
value = 3500
triggerall = command = "superteleportation"
triggerall = power >= 3000
triggerall = NumProjID(1400) = 0
triggerall = StateNo != [1090, 1098]
trigger1 = statetype = S         
trigger2 = stateno = 2000

;---------------------------------------------------------------------------

;Cosmo Charge
[State -1]
type = ChangeState
value = 900
triggerall = statetype = S
triggerall = Power < 3000
triggerall = ctrl = 1
trigger1 = command = "charge1"
trigger1 = command = "charge2"

;Fireball 1
[State -1]
type = ChangeState
value = 1000
triggerall = command = "fireball1"
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,299]) || (stateno = [400,499])
trigger2 = stateno != 440 ;Except for sweep kick
trigger2 = movecontact

;Fireball 2
[State -1]
type = ChangeState
value = 1010
triggerall = command = "fireball2"
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,299]) || (stateno = [400,499])
trigger2 = stateno != 440 ;Except for sweep kick
trigger2 = movecontact

;Fireball 3
[State -1]
type = ChangeState
value = 1020
triggerall = command = "fireball3"
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,299]) || (stateno = [400,499])
trigger2 = stateno != 440 ;Except for sweep kick
trigger2 = movecontact

;Flying kick
[State -1]
type = ChangeState
value = 1200
triggerall = command = "flyingkick"
trigger1 = statetype = S
trigger1 = ctrl = 1

;100 punches
[State -1]
type = ChangeState
value = 1300
triggerall = command = "100punches"
triggerall = command != "holddown"
trigger1 = statetype = S || statetype != A
trigger1 = ctrl

;100 punches 2
[State -1]
type = ChangeState
value = 1310
triggerall = command = "100punches2"
triggerall = command != "holddown"
trigger1 = statetype = S || statetype != A
trigger1 = ctrl

;100 kicks
[State -1]
type = ChangeState
value = 1320
triggerall = command = "100kicks"
triggerall = command != "holddown"
trigger1 = statetype = S || statetype != A
trigger1 = ctrl

; Harpoon
[State -1]
type = ChangeState
value = 1400
triggerall = command = "harpoon"
triggerall = command != "holddown"
trigger1 = statetype = S || statetype != A
trigger1 = ctrl

; Teleport
[State -1]
type = ChangeState
value = 1500
triggerall = command = "Teleportation"
triggerall = NumProjID(1400) = 0
triggerall = StateNo != [1090, 1098]
