;--|Controllers|-----------------------------------------------------------
[Statedef -1]

;===========================================================================
;-|Hypers|--------------------------------------------------------------------------
; furia di Shunrei
[State -1,]
type = ChangeState
value = 3000
triggerall = power >= 3000
triggerall = Var(59) = 0
triggerall = command = "Dragone"
trigger1 = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------------

; preghiera di Shunrei
[State -1,]
type = ChangeState
value = 3600
triggerall = power >= 2000
triggerall = Var(59) = 0
triggerall = command = "furiaS"
trigger1 = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------------

; Tornado di Shunrei
[State -1,]
type = ChangeState
value = 3100
triggerall = power >= 1000
triggerall = Var(59) = 0
triggerall = command = "Volontà"
trigger1 = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------------
; Desperate move - Rozan Shoryu Ha
[State -1,]
type = ChangeState
value = 3300
triggerall = var(10) = 0
triggerall = power >= 3000
triggerall = Var(59) = 0
;triggerall = p2bodydist x >= 60 && p2bodydist x < 150
triggerall = life <= 200
triggerall = command = "Rozan"
trigger1 = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------------
; Fatality Move - Testata del Dragone
[State -1,]
type = ChangeState
value = 3400
triggerall = var(10) = 0
triggerall = power >= 3000
triggerall = Var(59) = 0
triggerall = p2bodydist x >=20
triggerall = p2life <= 200
triggerall = command = "testata"
trigger1 = statetype != A
trigger1 = ctrl

