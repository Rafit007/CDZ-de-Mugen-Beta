;-|Hypers|--------------------------------------------------------

;Tornado di Fiore di Luna / ShunRei's Squall
[Command]
name = "Volontà"
command = ~B,DB,D,DF,F, x
time = 30

;Preghiera di Fiore di Luna/ ShunRei's Prayer
[Command]
name = "furiaS"
command = ~B,DB,D,DF,F, y
time = 30

;Furia di Fiore di Luna / ShunRei's Fury
[Command]
name = "Dragone"
command = ~B,DB,D,DF,F, z
time = 30

;Mossa Disperata - Soccorso di Sirio / Desperate Move - Shiryu's Help
[Command]
name = "Rozan"
command = ~B,DB,D,DF,F, a
time = 30

;Colpo di Grazia - Testata del Dragone / Fatality Move - Dragon's Header
[Command]
name = "testata"
command = ~B,DB,D,DF,F, b
time = 30

