command = B, B
time = 10

; Moves List
[Command]
name = "ss"
command = s, s
time = 10

;---------------------------------------
; CMD standard (Statedef -1)
;---------------------------------------

[Statedef -1]

; Cosmo Charge
[State -1]
type = ChangeState
value = 900
triggerall = Var(59) = 0
triggerall = var(8) = 0
triggerall = command = "charge1"
triggerall = command = "charge2"
triggerall = power < 3000
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger1 = stateno != 902

