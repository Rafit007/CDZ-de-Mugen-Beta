;-| Super Moves |------------------------------------------------------

; Lancia della Viverna (anche in aria) / Wyvern Lance (aerial too)
[Command]
name = "wyvernlance"
command = ~B, DB, D, DF, F, a
time = 40

; Castigo Infernale con Viverna / Greatest Caution with Wyvern
[Command]
name = "greatest1"
command = ~B, DB, D, DF, F, x
time = 40

; Occhi della Viverna / Wyvern Eyes
[Command]
name = "wyverneyes"
command = ~B, DB, D, DF, F, y
time = 40

; Castigo Infernale con Sfera / Greatest Caution with Sphere
[Command]
name = "greatest2"
command = ~B, DB, D, DF, F, z
time = 40

