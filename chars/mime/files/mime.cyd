;===========================================================================
; Player Variable
;===========================================================================

[Statedef -1]

;-------------------------
;-------------------------
;      Hyper Attack
;-------------------------
;-------------------------

[State -1, Desesperate]
type = ChangeState
value = 3300
triggerall = P2StateType != A
triggerall = var(59) != 1
triggerall = statetype = S
trigger1 = command = "Desesperate" && power >= 3000 && ctrl
trigger1 = life <= 250

[State -1, melodia tenebre]
type = ChangeState
value = 3000
triggerall = var(59) != 1
triggerall = statetype = S
trigger1 = command = "melodia tenebre" && power >= 3000 && ctrl

