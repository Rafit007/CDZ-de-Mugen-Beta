;-| Double Tap |-------------------------------------

; Run back
[Command]
name = "FF"     ; Required (do not remove)
command = F, F
time = 10

; Hop back
[Command]
name = "BB"     ; Required (do not remove)
command = B, B
time = 10

; Moves List
[Command]
name = "ss"
command = s, s
time = 10

;-| 2/3 Button Combination |---------------------------

; Air Recover
[Command]
name = "recovery";Required (do not remove)
command = x+y
time = 1

; Super Guard
[Command]
name = "mega_block"
command = B+c
time = 1

