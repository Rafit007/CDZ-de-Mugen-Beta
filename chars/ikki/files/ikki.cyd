;===========================================================================
; Super Motions
;===========================================================================

;Souvenir d'Esméralda (Memoria di Esmeralda)
[Command]
name = "Esmeralda"
command = F, DF, D, DB, B, x
time = 35

;Ultime Phoenix (Ultima Risorsa della Fenice)
[Command]
name = "Ultime Phoenix"
command = F, DF, D, DB, B, y
time = 35

;Phoenix no Ken (Pugno d'Acciaio della Fenice)
