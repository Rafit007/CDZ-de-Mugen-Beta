time = 1

;--------------------------------------------------------------------------
;-| Player Variable |------------------------------------------------------
;--------------------------------------------------------------------------

[Statedef -1]

;===========================================================================
;===========================================================================
;============================SAINT FINISH===================================
;===========================================================================
;===========================================================================
;[Souvenir d'Esméralda "contre]
[State -1,Souvenir d'Esmérald]
type = ChangeState
value = 4400
triggerall = var(59) = 0
triggerall = name = "ikkiG" || (name = "ikki" && palno >= 1 && palno <= 9)
triggerall = command = "Esmeralda" && power >= 3000 && statetype != A && ctrl
trigger1 = life <= 250
;===============================
;[Ultime Phoenix]
[State -1,Ultime Phoenix]
type = ChangeState
value = 4050
triggerall = var(59) = 0
triggerall = name = "ikkiG" || (name = "ikki" && palno >= 1 && palno <= 9)
triggerall = P2Name != "mu" && P2Name != "shaka"
triggerall = name = "ikkiG" || (name = "ikki" && palno >= 1 && palno <= 9)
triggerall = command = "Ultime Phoenix" && power >= 3000 && statetype != A && ctrl
trigger1 = life <= 250
trigger1 = (P2StateType = S) || (P2StateType = C)
;===============================
;[Phoenix no Ken]
[State -1,Phoenix no Ken]
type = ChangeState
value = 3100
triggerall = var(59) = 0
triggerall = name = "ikkiE" || (name = "ikki" && palno >= 10 && palno <= 12)
;triggerall = (P2Name = "hyoga") || (P2Name = "Hyoga de Cisne") || (P2Name = "guilty")
triggerall = power >= 3000 && statetype = S && ctrl
triggerall = command = "Ken"
trigger1 = P2life <= 250 ;&& P2BodyDist X >= 150
