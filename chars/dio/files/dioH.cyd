;-------------------------
;-------------------------
;      Super Ataques
;-------------------------
;-------------------------

; vôo mortal 1
[State -1, voo]
type = ChangeState
value = 4000
triggerall = power >= 3000
triggerall = command = "mortal"
trigger1 = statetype = S
trigger1 = ctrl
trigger2 = hitdefattr = SC,NA,SA
trigger2 = movecontact

[State -1, voo]
type = ChangeState
value = 9000
triggerall = command = "deadflyend"
triggerall = power >= 2000
trigger1 = statetype = S
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = hitdefattr = SC,NA
trigger2 = movecontact
[State -1, voo]
type = ChangeState
value = 9010
triggerall = power >= 3000
triggerall = command = "deadflyends"
trigger1 = statetype = S
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = hitdefattr = SC,NA
trigger2 = movecontact
;chute
[State -1]
type = ChangeState
value = 2000
triggerall = command = "chute"
triggerall = power >= 2000
triggerall = p2bodydist X < 100
trigger1 = statetype != A
trigger1 = ctrl = 1
trigger2 = hitdefattr = SC,NA
trigger2 = movecontact


[State -1, BALL]
type = ChangeState
value = 3000
triggerall = P2Stateno != 003&&P2life != 1
triggerall = command = "KannonBall"
triggerall = power >= 100
trigger1 = statetype = S
trigger1 = statetype != A
trigger1 = ctrl
trigger2 =  (stateno = [200,440]) && (stateno !=[600,640])
trigger2 = movecontact


[State -1, KANNON BALL AEREO]
type = ChangeState
value = 3010
triggerall = P2Stateno != 003&&P2life != 1
triggerall = command = "KannonBallAereo"
triggerall = power >= 100
trigger1 = statetype != S
trigger1 = statetype = A
trigger1 = ctrl
trigger2 =  (stateno =[600,640])
trigger2 = movecontact


;moscafinal
[state -1, lanzar]
type = ChangeState
value = 90000
triggerall = command = "moscafinal"
triggerall = ctrl
triggerall = power > 2000
trigger1 = statetype = S
trigger1 = p2statetype = A


