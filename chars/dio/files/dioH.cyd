triggerall = command = "c"
triggerall = command != "holddown"
trigger1 = statetype = S
trigger1 = ctrl
trigger2 = stateno = 230
trigger2 = movecontact = 1
trigger3 = stateno = 250
trigger3 = movecontact = 1
trigger4 = stateno = 210
trigger4 = movecontact = 1


