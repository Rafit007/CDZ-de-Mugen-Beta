;---------------------------------------
; CMD standard (Statedef -1)
;---------------------------------------

[Statedef -1]

;[State -1, Combo condition Reset]
;type = VarSet
;trigger1 = 1
;var(1) = 0
;
;[State -1, Combo condition Check]
;type = VarSet
;trigger1 = statetype != A
;trigger1 = ctrl
;trigger2 = (stateno = [200,299]) || (stateno = [400,499])
;trigger2 = stateno != 440 ;Except for sweep kick
;trigger2 = movecontact
;var(1) = 1

;---------------------------------------------------------------------------

; Dead End Fly (mortal)
;[State -1, dead end fly mortal]
;type = ChangeState
;value = 3800
;triggerall = power >= 3000
;triggerall = command = "deadendflym"
;trigger1 = statetype = S
;trigger1 = ctrl
;trigger2 = hitdefattr = SC,NA,SA
;trigger2 = movecontact

; Dead End Fly (final)
;[State -1, dead end fly final]
;type = ChangeState
;value = 3500
;triggerall = command = "deadendflyf"
;triggerall = ctrl
;triggerall = power > 3000
;trigger1 = statetype = S
;trigger1 = p2statetype = A

; Sirius and Algethi Combo Attack (Specter)
[State -1]
type = ChangeState
value = 3700
triggerall = Var(59) = 0
triggerall = name = "dioH" || name = "dio" && palno = 5 || name = "dio" && palno = 11
triggerall = command = "sirius&algethi"
triggerall = p2name != "sirius"
triggerall = p3name != "sirius"
triggerall = p4name != "sirius"
triggerall = p2name != "siriusH"
triggerall = p3name != "siriusH"
triggerall = p4name != "siriusH"
triggerall = p2name != "siriusS"
triggerall = p3name != "siriusS"
triggerall = p4name != "siriusS"
triggerall = p2name != "algethi"
triggerall = p3name != "algethi"
triggerall = p4name != "algethi"
triggerall = p2name != "algethiH"
triggerall = p3name != "algethiH"
triggerall = p4name != "algethiH"
triggerall = p2name != "algethiS"
triggerall = p3name != "algethiS"
triggerall = p4name != "algethiS"
triggerall = p2life <= 250
triggerall = power >= 3000
trigger1 = statetype = S
trigger1 = ctrl
trigger2 = stateno = 200 && MoveContact
trigger3 = stateno = 230 && MoveContact
trigger4 = stateno = 210 && MoveContact
trigger5 = stateno = 220 && MoveContact
trigger6 = stateno = 240 && MoveContact
trigger7 = stateno = 250 && MoveContact

; Sirius and Algethi Combo Attack (Silver)
[State -1]
type = ChangeState
value = 3600
triggerall = Var(59) = 0
triggerall = name = "dioS" || name = "dio" && palno != 5 || name = "dio" && palno != 11
triggerall = command = "sirius&algethi"
triggerall = p2name != "sirius"
triggerall = p3name != "sirius"
triggerall = p4name != "sirius"
triggerall = p2name != "siriusH"
triggerall = p3name != "siriusH"
triggerall = p4name != "siriusH"
triggerall = p2name != "siriusS"
triggerall = p3name != "siriusS"
triggerall = p4name != "siriusS"
triggerall = p2name != "algethi"
triggerall = p3name != "algethi"
triggerall = p4name != "algethi"
triggerall = p2name != "algethiH"
triggerall = p3name != "algethiH"
triggerall = p4name != "algethiH"
triggerall = p2name != "algethiS"
triggerall = p3name != "algethiS"
triggerall = p4name != "algethiS"
triggerall = p2life <= 250
triggerall = power >= 3000
trigger1 = statetype = S
trigger1 = P2StateType != A
trigger1 = ctrl = 1
trigger2 = stateno = 200 && MoveContact
trigger3 = stateno = 230 && MoveContact
trigger4 = stateno = 210 && MoveContact
trigger5 = stateno = 220 && MoveContact
trigger6 = stateno = 240 && MoveContact
trigger7 = stateno = 250 && MoveContact

; Infernal Dead End Fly
[State -1]
type = ChangeState
value = 3400
triggerall = name = "dioH"; || name = "dio" && palno = 5 || name = "dio" && palno = 11
triggerall = command = "deadendflyd"
triggerall = power >= 2000
triggerall = p2bodydist X < 100
trigger1 = statetype != A
trigger1 = ctrl = 1
trigger2 = hitdefattr = SC,NA
trigger2 = movecontact

; SoundSpeed Combo
[State -1, SoundSpeed Combo]
type = ChangeState
value = 3300
triggerall = command = "soundcombo"
triggerall = power >= 1000
triggerall = statetype =  S
trigger1 = ctrl = 1

; Dead End Fly 3
[State -1, Dead End Fly 3]
type = ChangeState
value = 3200
triggerall = command = "deadendfly3"
triggerall = power >= 3000
triggerall = statetype != A
trigger1 = statetype = S
trigger1 = ctrl
trigger2 = hitdefattr = SC,NA
trigger2 = movecontact

; Dead End Fly 2
[State -1, Dead End Fly 2]
type = ChangeState
value = 3100
triggerall = command = "deadendfly2"
triggerall = power >= 2000
triggerall = statetype != A
trigger1 = statetype = S
trigger1 = ctrl
trigger2 = hitdefattr = SC,NA
trigger2 = movecontact

; Dead End Fly 1
[State -1, Dead End Fly 1]
type = ChangeState
value = 3000
triggerall = command = "deadendfly1"
triggerall = power >= 1000
triggerall = statetype != A
trigger1 = ctrl
trigger2 = hitdefattr = SC, NA, SA, HA
trigger2 = stateno != [3050,1100)
trigger2 = movecontact

