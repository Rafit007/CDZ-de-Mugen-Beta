;-| Double Tap |-------------------------------------

; Run Forward
[Command]
name = "FF"     ;Required (do not remove)
command = F, F
time = 10

; Run Back
[Command]
name = "BB"     ;Required (do not remove)
command = B, B
time = 10

; Moves List
[Command]
name = "ss"
command = s, s
time = 10

;-| 2/3 Button Combination |---------------------------

; Recover
[Command]
name = "recovery";Required (do not remove)
command = x+y
time = 1

; Fire Sword ON/OFF
[Command]
name = "Sword on/off"
command = x+y
time = 25

; Deception
[Command]
name = "deception"
command = y+z
time = 25

; Roll
[Command]
name = "roll"
command = a+b
time = 1

; Cosmo Charge
[Command]
name = "charge1"
command = /c
time= 1
[Command]
name = "charge2"
command= /z
time= 1

