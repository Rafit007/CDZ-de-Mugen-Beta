;---------------------------------------
; CMD standard (Statedef -1)
;---------------------------------------

[Statedef -1]

;---------------------------------------
; Nature Unity 3
[State -1]
type = ChangeState
value = 3200
triggerall = Var(59) = 0
triggerall = command = "natureunity3"
triggerall = power >= 3000
triggerall = life <= 250
triggerall = statetype != A
;triggerall = p2statetype = S || p2statetype = C
trigger1 = ctrl

