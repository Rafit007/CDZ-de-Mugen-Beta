;-| Super Moves |--------------------------------------------------------

; Taglio dell'Orecchio / Ear-Cutting
[Command]
name = "earcutting"
command = B, DB, D, DF, F, x
time = 30

; Spallata Sanguinaria/ Bloody Shoulder Block
[command]
name = "Spallata"
command = B, DB, D, DF, F, y
time = 30

; Abbraccio Letale / Deadly Hug
[Command]
name = "hug"
command = B, DB, D, DF, F, c
time = 30

; Pugno Devastante / Devastating Punch
[Command]
name = "quake"
command = B, DB, D, DF, F, z
time = 30

; Calcio Devastante / Devastating Kick
[Command]
name = "quakek"
command = B, DB, D, DF, F, a
time = 30
[Command]
name = "quakek"
command = B, DB, D, DF, F, b
time = 30

;-| Special Moves |------------------------------------------------------

; Tripla Spallata / Triple Shoulder Block
[command]
name = "TreSpallate"
command = D, DF, F, x
time = 25
[command]
name = "TreSpallate"
command = D, DF, F, y
time = 25
[command]
name = "TreSpallate"
command = D, DF, F, z
time = 25

; Lancio in avanti / Throw Ahead
[command]
name = "Throwahead"
command = D, DB, B, x
time = 25

;Proiezione / Projection
[command]
name = "Projection"
command = D, DB, B, y
time = 25

; Lancio all'indietro / Back Drop
[command]
name = "Backdrop"
command = D, DB, B, z
time = 25

; Super Calcio Medio / Super Medium Kick
[command]
name = "SCalcioMedio"
command = D, DF, F, a
time = 25
[command]
name = "SCalcioMedio"
command = D, DF, F, b
time = 25

; Super Calcio Forte / Super Strong Kick
[command]
name = "SCalcioForte"
command = D, DF, F, c
time = 25

; Calcio Terremotante / Earthquaking Kick
[command]
name = "terremoto"
command = D, DB, B, a
time = 25
[command]
name = "terremoto"
command = D, DB, B, b
time = 25
[command]
name = "terremoto"
command = D, DB, B, c
time = 25

;-| Button Combination |---------------------------------------------------

; Carica Energia / Power Charge
[command]
name = "Cosmo"
command = c+z
time = 1

; Barriera di Muscoli/ Muscles Barrier
[command]
name = "muscoli"
command = y+z
time = 1

; Schivata / Dodge
[Command]
name = "dodge"
command = a+b
time = 1

; Air Recover
[Command]
name = "recovery";Required (do not remove)
command = x+y
time = 1

;-| Double Tap |-----------------------------------------------------------

[command]
name = "ff"     ;required (do not remove)
command = F, F
time = 10

[command]
name = "bb"     ;required (do not remove)
command = B, B
time = 10

; Moves List
[Command]
name = "ss"
command = s, s
time = 10

