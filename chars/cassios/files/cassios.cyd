name = "holdfwd";required (do not remove)
command = /$F
time = 1

[command]
name = "holdback";required (do not remove)
command = /$B
time = 1

[command]
name = "holdup" ;required (do not remove)
command = /$U
time = 1

[command]
name = "holddown";required (do not remove)
command = /$D
time = 1

[command]
name = "holdx"
command = /x
time = 1

[command]
name = "holdy"
command = /y
time = 1

[command]
name = "holdz"
command = /z
time = 1

[command]
name = "holda"
command = /a
time = 1

[command]
name = "holdb"
command = /b
time = 1

[command]
name = "holdc"
command = /c
time = 1

;---------------------------------------------------------------------------
; 2. state entry
;---------------------------------------------------------------------------

[statedef -1]

;===========================================================================

;Ear-Cutting
[state -1]
type = changestate
value = 3000
triggerall = power >= 1000
triggerall = command = "earcutting"
triggerall = Var(59) = 0
triggerall = var(26) != 2
trigger1 = statetype = S
trigger1 = ctrl = 1

;---------------------------------------------------------------------------

;Presa Sanguinaria / Bloody Hold
