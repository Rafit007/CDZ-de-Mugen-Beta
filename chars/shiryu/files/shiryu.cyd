[Statedef -1]

; Cosmo Charge
[State -1]
type = ChangeState
value = 900
triggerall = Var(59) = 0
triggerall = var(8) = 0
triggerall = Power < 3000
triggerall = command = "charge1"
triggerall = command = "charge2"
trigger1 = statetype = S
trigger1 = ctrl = 1

