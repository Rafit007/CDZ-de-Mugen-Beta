;---------------------------------------
; Super Moves
;---------------------------------------

; Rozan ShoRyuHa (vertical)
[Command]
name = "shoryuha1a"
command = B, DB, D, DF, F, x
time = 35

; Rozan RyuHiSho
[Command]
name = "ryuhisho1"
command = B, DB, D, DF, F, a
time = 35

; Rozan ShoRyuHa (horizontal)
[Command]
name = "shoryuha1b"
command = B, DB, D, DF, F, y
time = 35

; Rozan Waterfall Kick
[Command]
name = "waterfallkick"
command = B, DB, D, DF, F, b
time = 35

; Rozan ShoRyuHa (without Cloth)
[Command]
name = "shoryuha2"
command = B, DB, D, DF, F, z
time = 35

; Rozan RyuHiSho (without Cloth)
[Command]
name = "ryuhisho2"
command = B, DB, D, DF, F, c
time = 35

