; Don't remove the following line. It's required by the CMD standard.
[Statedef -1]

;===========================================================================

;Potenziamento
[State -1]
type = ChangeState
value = 900
triggerall = var(59) = 0
triggerall = statetype = S
triggerall = Power < 3000
triggerall = ctrl = 1
trigger1 = command = "charge"
trigger1 = command = "charge 1"

