triggerall = command = "Uragano2"
triggerall = p2bodydist X >= 40
triggerall = power >= 3000
triggerall = p2life <= 250
triggerall = p2name != "ushio" && p3name != "ushio" && p4name != "ushio"
triggerall = p2name != "daichi" && p3name != "daichi" && p4name != "daichi"
trigger1 = statetype != A
trigger1 = ctrl = 1

