;===========================================================================
; Don't remove the following line. It's required by the CMD standard.
[Statedef -1]

; 1000 scratches
[State -1]
type = ChangeState
value = 3000
triggerall = power >= 1000
triggerall = command = "1000scratches"
trigger1 = statetype = S 
trigger1 = ctrl = 1

; Lionet Bomber 1
[State -1]
type = ChangeState
value = 3100
triggerall = power >= 1000
triggerall = command = "lionetbomber1"
triggerall =  statetype = S
trigger1 = ctrl = 1

; Lionet Bomber 2
[State -1]
type = ChangeState
value = 3200
triggerall = command = "lionetbomber2"
triggerall = power >= 2000
trigger1 = statetype = S 
trigger1 = ctrl = 1

; Lionet Bomber 3
[State -1]
type = ChangeState
value = 3300
triggerall = command = "lionetbomber3"
triggerall = power >= 3000
trigger1 = statetype = S
trigger1 = ctrl = 1

;;7th Sense
;[State -1]
;type = changestate
;value = 999
;triggerall = command = "7sense"
;triggerall = power >= 3000
;triggerall = life < 250
;trigger1 = statetype != A
;trigger1 = ctrl = 1
;trigger2 = hitdefattr = SC, NA, SA
;trigger2 = movecontact

;---------------------------------------------------------------------------

; 100 scratches
[State -1]
type = ChangeState
value = 1600
triggerall = command = "100scratches"
trigger1 = statetype = S 
trigger1 = ctrl

; Super Punch
[State -1]
type = ChangeState
value = 1000
triggerall = command = "superpunch"
trigger1 = ctrl = 1
trigger1 = statetype = S

; Lionet Kick
[State -1]
type = ChangeState
value = 1100
triggerall = command = "lionetkick"
trigger1 = statetype = S 
trigger1 = ctrl = 1

; Lionet Fire
[State -1]
type = ChangeState
value = 1200
triggerall = command = "lionetfire"
trigger1 = statetype = S 
trigger1 = ctrl = 1

; Flying Kick
[State -1]
type = ChangeState
value = 1300
triggerall = command = "flyingkick"
trigger1 = statetype = A
trigger1 = ctrl = 1

; Counter
[State -1]
type = ChangeState
value = 1400
triggerall = command = "counter"
triggerall = P2StateType = S
trigger1 = StateType = S
trigger1 = ctrl = 1

; Combo
[State -1]
type = ChangeState
value = 1500
triggerall= command = "combo"
triggerall = statetype != A
trigger1 = ctrl

;---------------------------------------------------------------------------

; Throw 1
[State -1, Throw 1]
type = ChangeState
value = 800
triggerall = command = "holdfwd"
triggerall = command =  "z"
trigger1 = p2bodydist X < 30
trigger1 = StateType = S
trigger1 = Ctrl = 1

; Throw 2
[State -1, Throw 2]
type = ChangeState
value = 830
triggerall = command = "holdfwd"
triggerall = command =  "c"
trigger1 = statetype = S
trigger1 = stateno != 100
trigger1 = p2statetype = S
trigger1 = P2bodydist X <= 10
trigger1 = P2movetype!= H
trigger1 = ctrl = 1

;---------------------------------------------------------------------------
; Cosmo Charge
[State -1]
type = ChangeState
value = 900
triggerall = var(59) = 0
triggerall = var(8) = 0
triggerall = power < 3000
triggerall = command = "charge1"
triggerall = command = "charge2"
trigger1 = statetype = S
trigger1 = ctrl = 1

;---------------------------------------------------------------------------
; Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100
trigger1 = command = "FF"
trigger1 = statetype = S
trigger1 = ctrl

;---------------------------------------------------------------------------
; Run Back
[State -1, Run Back]
type = ChangeState
value = 105
trigger1 = command = "BB"
trigger1 = statetype = S
trigger1 = ctrl

;---------------------------------------------------------------------------
; Standing light punch
[State -1, Stand light punch]
type = ChangeState
value = 200
triggerall = command = "x"
triggerall = command != "holddown"
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger2 = (stateno = 230) && (MoveContact)
trigger3 = (stateno = 220) && (MoveContact)
trigger4 = (stateno = 255) && (MoveContact)
trigger5 = (stateno = 210) && (MoveContact)

;---------------------------------------------------------------------------
; Standing medium punch
[State -1, Stand medium punch]
type = ChangeState
value = 210
triggerall = command = "y"
triggerall = command != "holddown"
trigger1 =  P2BodyDist X >= 25
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger2 = (stateno = 240) && (MoveContact)
trigger3 = (stateno = 200) && (MoveContact)
trigger4 = (stateno = 230) && (MoveContact)
trigger5 = (stateno = 220) && (MoveContact)

;---------------------------------------------------------------------------
; Standing medium punch close
[State -1, Stand medium punch close]
type = ChangeState
value = 215
triggerall = command = "y"
triggerall = command != "holddown"
trigger1 =  P2BodyDist X <= 24
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger2 = (stateno = 240) && (MoveContact)
trigger3 = (stateno = 200) && (MoveContact)
trigger4 = (stateno = 230) && (MoveContact)
trigger5 = (stateno = 220) && (MoveContact)

;---------------------------------------------------------------------------
; Standing strong punch
[State -1, Standing strong punch]
type = ChangeState
value = 220
triggerall = command = "z"
triggerall = command != "holddown"
trigger1 =  P2BodyDist X >= 24
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger2 = stateno = 240 || stateno = 200 || stateno = 210 || stateno = 230
trigger2 = movecontact = 1
trigger3 = (stateno = 250) && (MoveContact)

;---------------------------------------------------------------------------
; Standing strong punch close
[State -1, Stand strong punch close]
type = ChangeState
value = 225
triggerall = command = "z"
triggerall = command != "holddown"
trigger1 =  P2BodyDist X <= 24
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger2 = stateno = 240 || stateno = 200 || stateno = 210 || stateno = 230
trigger2 = movecontact = 1
trigger3 = (stateno = 250) && (MoveContact)

; Running strong punch)
[State -1, Running strong punch]
type = ChangeState
value = 226
triggerall = stateno = 100
trigger1 = command = "z"
triggerall = statetype = S
triggerall = ctrl = 1

;--------------------------------------------------------------------------------
; Standing light kick
[State -1, Standing light kick]
type = ChangeState
value = 230
triggerall = command = "a"
triggerall = command != "holddown"
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger2 = stateno = 240 || stateno = 200 || stateno = 210
trigger2 = movecontact = 1
trigger3 = (stateno = 255) && (MoveContact)

;---------------------------------------------------------------------------------
; Standing medium kick
[State -1, Stand medium kick]
type = ChangeState
value = 240
triggerall = command = "b"
triggerall = command != "holddown"
trigger1 =  P2BodyDist X >= 20
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger2 = (stateno = 200) && (MoveContact)
trigger3 = (stateno = 230) && (MoveContact)
trigger4 = (stateno = 210) && (MoveContact)
trigger5 = (stateno = 245) && (MoveContact)
trigger6 = (stateno = 250) && (MoveContact)

;--------------------------------------------------------------------------------
; Standing medium kick close
[State -1, Stand medium kick close]
type = ChangeState
value = 245
triggerall = command = "b"
triggerall = command != "holddown"
trigger1 =  P2BodyDist X < 20
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger2 = (stateno = 200) && (MoveContact)
trigger3 = (stateno = 230) && (MoveContact)
trigger4 = (stateno = 210) && (MoveContact)
trigger5 = (stateno = 240) && (MoveContact)
trigger6 = (stateno = 250) && (MoveContact)

;----------------------------------------------------------------------------------
; Standing strong kick
[State -1, Stand strong kick]
type = ChangeState
value = 250
triggerall = command = "c"
triggerall = command != "holddown"
trigger1 =  P2BodyDist X >= 20
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger2 = (stateno = 210) && (MoveContact)
trigger3 = (stateno = 240) && (MoveContact)
trigger4 = (stateno = 245) && (MoveContact)
trigger5 = (stateno = 220) && (MoveContact)
trigger6 = (stateno = 255) && (MoveContact)

;---------------------------------------------------------------------------
; Standing strong kick close
[State -1, Stand strong kick close]
type = ChangeState
value = 255
triggerall = command = "c"
triggerall = command != "holddown"
trigger1 =  P2BodyDist X < 20
trigger1 = statetype = S
trigger1 = ctrl = 1
trigger2 = (stateno = 210) && (MoveContact)
trigger3 = (stateno = 240) && (MoveContact)
trigger4 = (stateno = 200) && (MoveContact)
trigger5 = (stateno = 220) && (MoveContact)
trigger6 = (stateno = 250) && (MoveContact)

;---------------------------------------------------------------------------
; Crouching light punch
[State -1, Crouching light punch]
type = ChangeState
value = 400
triggerall = command = "x"
triggerall = command = "holddown"
trigger1 = statetype = C
trigger1 = ctrl = 1 
trigger2 = (stateno = 430) && (MoveContact)

;---------------------------------------------------------------------------
; Crouching medium punch
[State -1, Crouching medium punch]
type = ChangeState
value = 410
triggerall = command = "y"
triggerall = command = "holddown"
trigger1 =  P2BodyDist X >= 10
trigger1 = statetype = C
trigger1 = ctrl = 1
trigger2 = (stateno = 400) && (MoveContact)
trigger3 = (stateno = 430) && (MoveContact)
trigger4 = (stateno = 440) && (MoveContact)

;---------------------------------------------------------------------------
; Crouching medium punch close
[State -1, Crouching medium punch close]
type = ChangeState
value = 425
triggerall = command = "y"
triggerall = command = "holddown"
trigger1 =  P2BodyDist X < 10
trigger1 = statetype = C
trigger1 = ctrl = 1
trigger2 = (stateno = 410) && (MoveContact)
trigger3 = (stateno = 440) && (MoveContact)

;---------------------------------------------------------------------------
; Crouching strong punch
[State -1, Crouching strong punch]
type = ChangeState
value = 420
triggerall = command = "z"
triggerall = command = "holddown"
trigger1 = statetype = C
trigger1 = ctrl = 1

;------------------------------------------------------------------------------
; Crouching light kick
[State -1, Crouching light kick]
type = ChangeState
value = 430
triggerall = command = "a"
triggerall = command = "holddown"
trigger1 = statetype = C
trigger1 = ctrl = 1
trigger2 = (stateno = 400) && (MoveContact)

;------------------------------------------------------------------------
; Crouching medium kick
[State -1, Crouching medium kick]
type = ChangeState
value = 440
triggerall = command = "b"
triggerall = command = "holddown"
trigger1 = statetype = C
trigger1 = ctrl = 1
trigger2 = (stateno = 400) && (MoveContact)
trigger3 = (stateno = 430) && (MoveContact)
trigger4 = (stateno = 410) && (MoveContact)

;---------------------------------------------------------------------------
; Crouching strong kick
[State -1, Crouching strong kick]
type = ChangeState
value = 450
triggerall = command = "c"
triggerall = command = "holddown"
trigger1 = statetype = C
trigger1 = ctrl = 1
