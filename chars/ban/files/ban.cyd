;-| Double Tap |-----------------------------------------------------------

[Command]
name = "FF"     ;Required (do not remove)
command = F, F
time = 10

[Command]
name = "BB"     ;Required (do not remove)
command = B, B
time = 10

; Moves List
[Command]
name = "ss"     ;Required (do not remove)
command = s, s
time = 10

